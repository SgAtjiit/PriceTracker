# Server configuration
PORT=4000

# Supabase database configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key

# Allowed CORS origins (comma-separated for multiple origins, no trailing slashes)
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Secret key required in x-cron-secret header for batch cron endpoint
CRON_SECRET=your-secure-cron-secret-key

# Scraper configuration
SCRAPE_HEADLESS=true
DEBUG_SCREENSHOTS=false
